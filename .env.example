# Copy to .env. Everything is optional: with no keys the app runs on free data
# (Yahoo Finance candles + NSE public option chain + RSS news).

# ---- Web server ---------------------------------------------------------
PORT=3001

# ---- Groww Trade API (optional, official live candles + option chain with Greeks)
# TOTP key type recommended (no daily manual approval)
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
# or API key + secret (needs daily approval on Groww Cloud API Keys page)
GROWW_API_KEY=
GROWW_API_SECRET=

# ---- Claude (optional, much better news understanding than the local model)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Live refresh -------------------------------------------------------
TICK_SECONDS=1              # live price push to the browser (Yahoo only refreshes ~10 s; Groww streams ticks)
REFRESH_SECONDS=10          # 1-min candles + full analysis during market hours
CHAIN_REFRESH_SECONDS=60    # option chain (be gentle with NSE)

# ---- MCX without Groww keys: real MCX prices from Moneycontrol's public price API
MCX_TICK_SECONDS=3          # futures quotes for all commodities (one request each)
MCX_CHAIN_REFRESH_SECONDS=180   # option chain per commodity (2 requests per strike)
MCX_CHAIN_WIDTH=6           # strikes either side of the money in the MCX option chain

# ---- Prediction log (docs/data/*.json, always written) + GitHub Pages publishing
PUBLISH_GIT=0               # 1 = git commit + push docs/data every hour and at each close
PUBLISH_REMOTE=origin

# ---- Signal rules -------------------------------------------------------
SIGNAL_THRESHOLD=45         # |score| needed for BUY CALL / BUY PUT (0-100)
MIN_ADX=18                  # below this the market is treated as choppy: no signals
NO_SIGNAL_BEFORE=09:30      # skip the opening 15 minutes
NO_SIGNAL_AFTER=14:45       # no fresh intraday option buys late in the day
